# Supabase project URL and anon key (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of this deployment. Used to build auth redirect URLs
# (email confirmation links and the Google OAuth callback).
# Local: http://localhost:3000 — Production: your deployed https:// URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
